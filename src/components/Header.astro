---
import { SITE } from "../data/site.js";
import Logo from "./Logo.astro";
import { SERVICES } from "../data/services.js";
import { SHOW_GP } from "../data/flags.js";
import { getArticles, ARTICLES_HREF } from "../lib/articles.js";
const { current = "" } = Astro.props;
// The Articles link shows once at least one article is published.
const hasArticles = (await getArticles()).length > 0;
const isService = SERVICES.some((x) => x.slug === current);
const links = [
  { href: "/#services", label: "Services", key: isService ? current : "home" },
  ...(SHOW_GP ? [{ href: "/gp-clinics/", label: "GP clinics", key: "gp-clinics" }] : []),
  { href: "/work/", label: "Case studies", key: "work" },
  ...(hasArticles ? [{ href: ARTICLES_HREF, label: "Articles", key: "articles" }] : []),
  { href: "/about/", label: "About", key: "about" },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={SITE.brand + " home"}><Logo id="logo-h" /></a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current === l.key ? "page" : undefined}>{l.label}</a>)}
      <a class="btn small" href="/#contact">Talk to us</a>
    </nav>
  </div>
</header>
