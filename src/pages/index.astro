---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { SERVICES, isShown } from "../data/services.js";
import { SITE, FOUNDER_PROFILE } from "../data/site.js";
import { originOf, website, org, person, ld } from "../lib/schema.js";
import { numberWord, capitalise } from "../lib/format.js";
import { FAQ, faqJsonLd } from "../data/faq.js";
import { SHOW_GP } from "../data/flags.js";
import { FROM_PRICE, CARE_PLAN } from "../data/gp.js";
import { money } from "../lib/format.js";
const origin = originOf(Astro.site);
const NUM = capitalise(numberWord(SERVICES.length));
const title = "Studio Narrm | Data, Automation & AI Agents, Melbourne";
const description = "Studio Narrm is a Melbourne studio for data dashboards, n8n workflow automation, AI agents, custom apps and websites, founded by Pranav Gore, a solution architect with 19 years in banking, telecom and non-profits.";
// The home page carries the full graph (with the founder’s credentials and skills) instead of Base’s,
// so it sets includeBase={false}. Base stamps dateModified on the ProfilePage node.
const jsonld = [
  ld({
    "@graph": [
      website(origin),
      org(origin),
      { "@type": "ProfilePage", "@id": `${origin}/#profile`, url: `${origin}/`, isPartOf: { "@id": `${origin}/#website` }, mainEntity: { "@id": `${origin}/#person` } },
      person(origin, FOUNDER_PROFILE),
      faqJsonLd(origin),
    ],
  }),
  ld({
    "@type": "ItemList",
    name: "Services",
    itemListElement: SERVICES.map((sv, i) => ({ "@type": "ListItem", position: i + 1, name: sv.eyebrow, url: origin + sv.href })),
  }),
];
// Selected work for the home index: capability level only, each row links to its case study on /work/.
const WORK = [
  ["Operational analytics platform for a regional programme", "Analytics", "t-data", "analytics-platform"],
  ["Production data pipelines and automation in n8n", "Automation", "t-flow", "n8n-workflows"],
  ["AI agents for outreach and data extraction", "AI agents", "t-flow", "ai-agents"],
  ["Low-code operational apps", "Apps", "t-apps", "low-code"],
  ["Customer master migration after a bank acquisition", "Banking", "t-data", "customer-master"],
  ["Open Banking and microservices integration", "Banking", "t-data", "open-banking"],
  ["Taking over a large enterprise automation estate", "Telecom", "t-rpa", "rpa"],
  ["Telecom order management and fulfilment", "Telecom", "t-rpa", "telecom"],
];
const DATA = SERVICES.find((x) => x.slug === "data-viz");
const MARQUEE = ["Banking", "Telecommunications", "Telstra", "Retail", "Non-profit", "n8n", "AWS", "Claude", "Google AppSheet", "PostgreSQL", "Kafka", "Spring Boot", "Oracle OSM", "Looker Studio", "Docker"];
---
<Base title={title} description={description} jsonld={jsonld} current="home" includeBase={false}>
<main class="rd">
    <section class="rd-hero" aria-labelledby="hero-h">
      <canvas class="net" data-particle-network aria-hidden="true"></canvas>
      <div class="wrap">
        <h1 id="hero-h"><span class="line">Messy process in.</span> <span class="line"><span class="hl">Working system</span> out.</span></h1>
        <div class="rd-hero-foot">
          <p class="lead">Studio Narrm designs and builds automations, AI agents, dashboards, apps and websites in Melbourne.</p>
          <div class="cta">
            <a class="btn" href="#contact">Tell us about your problem</a>
            <a class="btn ghost" href="#services">See the work</a>
          </div>
        </div>
      </div>
    </section>

    <section class="rd-work" id="services" aria-labelledby="work-h">
      <div class="wrap">
        <div class="rd-work-lead">
          <h2 id="work-h">Selected work</h2>
          {DATA && DATA.shot && <a class="rd-lead-shot" href={DATA.href}><Shot shot={DATA.shot} /><span>A sample dashboard from our <u>data visualisation</u> page</span></a>}
        </div>
        <ol class="rd-index">
          {WORK.map(([t, kind, tone, id]) => <li class={tone}><a href={"/work/#" + id}><span class="rd-kind">{kind}</span><span class="rd-title">{t}</span></a></li>)}
        </ol>
        <p class="rd-more"><a href="/work/">All case studies</a></p>
      </div>
    </section>

    <section class="rd-do" aria-labelledby="do-h">
      <div class="wrap">
        <h2 id="do-h">{NUM} ways we can help, one way of working</h2>
        <ul class="rd-services">
          {SERVICES.map((sv) => (
            <li class={sv.tone} id={sv.slug}>
              <div class="rd-svc-head">
                <h3><a href={sv.href}>{sv.eyebrow}</a></h3>
                <p class="rd-q">{sv.kicker}</p>
              </div>
              <div class="rd-svc-body">
                <p>{sv.summary}</p>
                <ul class="rd-feats">{sv.feats.map(([b, t]) => <li><b>{b}.</b> {t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {SHOW_GP && <section class="rd-band" aria-labelledby="gp-h">
      <div class="wrap">
        <div>
          <h2 id="gp-h">Running a GP clinic in regional Victoria?</h2>
          <p>Get your Rule 21 Security and Access Policy in place and go fax-free, for a fixed fee.</p>
        </div>
        <p class="rd-price"><span>From</span><b>{FROM_PRICE}</b><span>+ GST, fixed fee. Care plan {money(CARE_PLAN.price)} a month.</span></p>
        <a class="btn" href="/gp-clinics/">See the GP clinic package</a>
      </div>
    </section>}

    <section class="rd-about" aria-labelledby="intro-h">
      <div class="wrap">
        <h2 id="intro-h">Architecture first. Then we build the thing.</h2>
        <div>
          <p>Pranav has spent <strong>19 years</strong> designing systems that big organisations depend on: <strong>core banking integration</strong>, <strong>telecom order fulfilment</strong>, and a fleet of <strong>100+ automation robots</strong> at Telstra.</p>
          <p>At Studio Narrm we build the whole thing, fast, with <strong>AI-assisted development</strong>. Data pipelines, AI agents, dashboards, mobile apps and full platforms. Different problems, same habit: understand it properly, keep it simple, ship it.</p>
          <ol class="rd-steps" aria-label="How we work">
            <li><b>Understand.</b> Map the process, the people and where the time goes.</li>
            <li><b>Design.</b> Architecture and data model, and the simplest path that works.</li>
            <li><b>Build.</b> Apps, integrations and agents, using AI to move fast.</li>
            <li><b>Automate.</b> Take people out of the copy-paste.</li>
            <li><b>Measure.</b> Dashboards that show whether it’s working.</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="served" aria-labelledby="served-h">
      <div class="wrap">
        <h2 id="served-h">Industries, teams &amp; tools</h2>
      </div>
      <div class="marquee">
        <ul>{MARQUEE.map((t) => <li>{t}</li>)}</ul>
        <ul aria-hidden="true">{MARQUEE.map((t) => <li>{t}</li>)}</ul>
      </div>
    </section>

    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div>
          <h2 id="faq-h">The quick answers</h2>
        </div>
        <div>
        {FAQ.map(([q, a], k) => <details open={k === 0}><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-h">
      <div class="wrap">
        <div>
          <h2 id="contact-h">Ready to fix something? Tell us about it.</h2>
          <p>A project, or a process that’s driving your team mad. We’re in Melbourne and happy to work remotely.</p>
        </div>
        <form id="contact-form" data-email={SITE.email} novalidate>
          <label for="f-name">Your name<input id="f-name" name="name" autocomplete="name" required></label>
          <label for="f-email">Email<input id="f-email" name="email" type="email" autocomplete="email" required></label>
          <fieldset>
            <legend>What do you need?</legend>
            <label><input type="checkbox" name="need" value="A solution architect"> An architect</label>
            <label><input type="checkbox" name="need" value="Automation or AI agents"> Automation or AI</label>
            <label><input type="checkbox" name="need" value="A dashboard"> A dashboard</label>
            <label><input type="checkbox" name="need" value="An app or platform"> An app</label>
            {SHOW_GP && <label><input type="checkbox" name="need" value="Rule 21 / GP clinic" id="f-gp"> Rule 21 / GP clinic</label>}
          </fieldset>
          {SHOW_GP && <div class="gp-fields">
            <label for="f-software">Practice software
              <select id="f-software" name="software">
                <option value="">Optional</option>
                <option>Best Practice</option>
                <option>MedicalDirector</option>
                <option>Zedmed</option>
                <option>Other</option>
                <option>Not sure</option>
              </select>
            </label>
            <label for="f-staff">Number of staff<input id="f-staff" name="staff" inputmode="numeric" placeholder="Optional"></label>
            <label for="f-town">Town<input id="f-town" name="town" autocomplete="address-level2" placeholder="Optional"></label>
          </div>}
          <label for="f-msg">Tell us about it<textarea id="f-msg" name="message" required></textarea></label>
          <button class="btn" type="submit">Send via email</button>
          <p class="form-note" id="form-note">This opens your email app with your message filled in.</p>
        </form>
      </div>
    </section>
  </main>
<script is:inline slot="scripts" src="/assets/particle-network.js" defer></script>
<script is:inline slot="scripts">
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('js');


    // Reveal: only elements below the fold start hidden
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.remove('pending'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach(function (el) { if (el.getBoundingClientRect().top > window.innerHeight) { el.classList.add('pending'); io.observe(el); } });
    }

    // Contact form opens a prefilled email
    var form = document.getElementById('contact-form');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var note = document.getElementById('form-note');
      if (!form.checkValidity()) { note.textContent = 'Please add your name, a valid email and a short message.'; return; }
      var needs = [].slice.call(form.querySelectorAll('input[name=need]:checked')).map(function (c) { return c.value; }).join(', ');
      var clinic = [['Practice software', form.software], ['Staff', form.staff], ['Town', form.town]].map(function (p) { return [p[0], p[1] ? p[1].value : '']; }).filter(function (p) { return p[1]; }).map(function (p) { return p[0] + ': ' + p[1]; }).join('\n');
      var body = form.message.value + '\n\n' + (needs ? 'Looking for: ' + needs + '\n' : '') + (clinic ? clinic + '\n' : '') + 'From: ' + form.name.value + ' <' + form.email.value + '>';
      window.location.href = 'mailto:' + form.dataset.email + '?subject=' + encodeURIComponent('Enquiry from ' + form.name.value) + '&body=' + encodeURIComponent(body);
      note.textContent = 'Your email app should open with the message ready to send. If nothing opens, set up an email app on this device and try again.';
    });
  })();
  </script>
</Base>
