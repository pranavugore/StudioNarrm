---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { originOf, breadcrumbs, ld } from "../../../lib/schema.js";
import { getArticles, articleHref, isoDate, ARTICLES_HREF } from "../../../lib/articles.js";
import { longDate } from "../../../lib/format.js";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { title, description, date, updated, tags } = article.data;
const { Content } = await render(article);
const origin = originOf(Astro.site);
const url = origin + articleHref(article);
const published = isoDate(date);
const modified = isoDate(updated || date);
const jsonld = [
  ld({
    "@type": "BlogPosting",
    "@id": url + "#article",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    author: { "@id": origin + "/#person" },
    publisher: { "@id": origin + "/#org" },
    image: origin + "/og.png",
    inLanguage: "en-AU",
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
    isPartOf: { "@id": origin + ARTICLES_HREF + "#webpage" },
  }),
  ld(breadcrumbs(origin, [["Home", "/"], ["Articles", ARTICLES_HREF], [title, articleHref(article)]])),
];
---
<Base title={`${title} | Studio Narrm`} description={description} jsonld={jsonld} current="articles" ogType="article" updated={modified}>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>
  <main class="wrap-main t-articles">
    <article class="guide">
      <div class="wrap">
        <nav class="crumbs mono" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={ARTICLES_HREF}>Articles</a> / <span>{title}</span></nav>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={published}>{longDate(published)}</time>
          {updated && <>, updated <time datetime={modified}>{longDate(modified)}</time></>}
        </p>
        <p class="lead">{description}</p>
        <div class="prose">
          <Content />
        </div>
        {tags.length > 0 && <ul class="tags article-tags" aria-label="Topics">{tags.map((t) => <li>{t}</li>)}</ul>}
        <aside class="guide-cta">
          <h2>Want help with this?</h2>
          <p>Studio Narrm designs and builds data dashboards, automation, AI agents and custom apps. Tell us what you’re trying to do and we’ll reply with a plan.</p>
          <a class="btn tone" href="/#contact">Start a project</a>
        </aside>
      </div>
    </article>
  </main>
</Base>
