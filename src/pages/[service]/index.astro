---
// One page per visible service that has page content (src/data/services.js). Hidden services build nothing.
import ServicePage from "../../layouts/ServicePage.astro";
import { SERVICES } from "../../data/services.js";
export function getStaticPaths() {
  return SERVICES.filter((s) => s.page).map((s) => ({ params: { service: s.slug } }));
}
---
<ServicePage slug={Astro.params.service} />
